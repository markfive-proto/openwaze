#!/usr/bin/env bash
# Fast checks before a push: lint if iOS files changed, server unit tests if
# server/ changed, judged from the commits being pushed. CI runs the full
# suite. Enabled by `make bootstrap` (git config core.hooksPath
# scripts/githooks). Skip once with --no-verify.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

zero=0000000000000000000000000000000000000000
changed=""
# stdin: <local ref> <local sha> <remote ref> <remote sha>, one line per ref.
while read -r _ local_sha _ remote_sha; do
  [ "$local_sha" = "$zero" ] && continue # deleting a remote branch
  if [ "$remote_sha" != "$zero" ] && git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    base="$remote_sha"
  else # new branch, or remote tip not fetched
    base="$(git merge-base origin/main "$local_sha" 2>/dev/null || true)"
  fi
  if [ -n "$base" ]; then
    changed+="$(git diff --name-only "$base" "$local_sha")"$'\n'
  else
    changed+=$'App/\nserver/\n'
  fi
done
has() { printf '%s\n' "$changed" | grep -qE "$1"; }

if has '^(App/|\.swiftlint\.yml$)'; then
  echo "pre-push: make lint"
  make lint
fi
if has '^server/'; then
  [ -d server/node_modules ] || { echo "pre-push: run 'npm ci' in server/ first." >&2; exit 1; }
  echo "pre-push: server tests"
  npm --prefix server test
fi
