# Paths that need a human review. Enforced once main's branch rule has
# "Require review from Code Owners" on. See docs/pr-gate.md.

# Location, probe and share code: privacy-sensitive.
/App/Sources/**/Location*  @markfive-proto
/App/Sources/**/Probe*     @markfive-proto
/App/Sources/**/Share*     @markfive-proto

# Server: report storage and data retention.
/server/src/               @markfive-proto

# Dependencies and build config: lockfile and install changes are reviewed
# (docs/security/known-vulns.md, actions 1 and 2).
/server/package.json       @markfive-proto
/server/package-lock.json  @markfive-proto
/server/.npmrc             @markfive-proto
/Brewfile                  @markfive-proto
/project.yml               @markfive-proto
**/Package.resolved        @markfive-proto

# The gate itself, and agent/editor config a PR could use to run code
# (docs/security/known-vulns.md, actions 7 and 10).
/.github/                  @markfive-proto
/scripts/                  @markfive-proto
/Makefile                  @markfive-proto
/.claude/                  @markfive-proto
/.mcp.json                 @markfive-proto
/.vscode/                  @markfive-proto

# Security and privacy docs.
/docs/security/            @markfive-proto
/docs/privacy.md           @markfive-proto
